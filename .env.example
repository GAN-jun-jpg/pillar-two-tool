# ===== AI 模型网关配置示例 =====
# 复制本文件为 .env 并填入真实密钥（.env 不要提交到 git / 打包）

# ── 第 0 步：选供应商 ──
# 填了哪一组 key，就把下面这行改成对应的名字（只会有一个生效）：
#   dashscope          ← 对应 QWEN_API_KEY（通义千问，国内推荐）
#   openai_compatible  ← 对应 LLM_API_KEY + LLM_BASE_URL
#   deepseek           ← 对应 DEEPSEEK_API_KEY（默认）
LLM_DEFAULT_PROVIDER=deepseek

# 方式一：通义千问 / DashScope OpenAI 兼容接口
QWEN_API_KEY=sk-你的key
QWEN_MODEL=qwen3-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 方式二：任意 OpenAI 兼容服务（Hello Agents 第四章风格）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_ID=

# 方式三：DeepSeek（可选）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
