# ===== AI 模型网关配置示例 =====
# 复制本文件为 .env 并填入真实密钥（.env 不要提交到 git / 打包）

# 方式一（推荐）：通义千问 / DashScope OpenAI 兼容接口
QWEN_API_KEY=sk-你的key
QWEN_MODEL=qwen3-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 方式二：任意 OpenAI 兼容服务（Hello Agents 第四章风格）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_ID=

# 方式三：DeepSeek（可选）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
